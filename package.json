{
  "name": "otools-puter-ps",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Photo Studio (HeyPuter/everything) as an OTools plugin: the same editor, with documents stored as plain files on this computer instead of in a Puter cloud account.",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "sync-upstream": "node scripts/sync-upstream.mjs",
    "check-upstream": "node scripts/sync-upstream.mjs --check",
    "tree": "node scripts/build.mjs --tree",
    "build": "node scripts/build.mjs",
    "dev": "node scripts/dev.mjs",
    "test": "node scripts/test.mjs",
    "preview": "node scripts/serve-dist.mjs",
    "pack": "node scripts/pack-plugin.mjs",
    "verify": "node scripts/verify-plugin.mjs",
    "i18n-report": "node scripts/i18n-report.mjs",
    "release": "node scripts/build.mjs && node scripts/pack-plugin.mjs && node scripts/verify-plugin.mjs"
  },
  "dependencies": {
    "ag-psd": "31.0.2",
    "lucide": "^0.468.0",
    "pako": "2.1.0",
    "pathkit-wasm": "1.0.0",
    "yjs": "13.6.33"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "@types/pako": "2.0.4",
    "@webgpu/types": "^0.1.60",
    "typescript": "~5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.3",
    "jsdom": "30.1.2"
  }
}
